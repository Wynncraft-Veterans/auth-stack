+/// Send a backend-supplied line to the player.
+///
+/// The text is decorated with MiniMessage markup for colour. A backend
+/// that puts a literal `<` in its message would make that parse fail, so
+/// the undecorated text is tried next rather than the player being told
+/// nothing at all.
+fn send_chat(batch: &mut Batch, client_state: &ClientState, text: &str) {
+    let decorated = format!("<gray>[Guild Hall]</gray> <yellow>{text}</yellow>");
+    let component = parse_mini_message(&decorated).or_else(|_| parse_mini_message(text));
+    if let Ok(component) = component {
+        send_message(batch, &component, client_state.protocol_version());
+    } else {
+        warn!("could not render backend chat message: {}", text);
+    }
+}
