+// Backwards-compat: if WYNN_CHAT_ROUTES is unset but REMOTE_API_URL is,
+// treat REMOTE_API_URL as a single default-only route so existing single-
+// backend deployments (dazebot only) keep working without touching env.
+//
+// The forward is `GET {url}/{uuid}/{stripped-msg}` and the response body
+// is parsed as JSON: a non-empty `kick_message` disconnects the player
+// with that text. Failures (network, non-2xx, missing/empty field) are
+// silent -- the chat line is dropped and the player stays connected.
+static ROUTES: LazyLock<Vec<Route>> = LazyLock::new(|| {
+    let raw = env::var("WYNN_CHAT_ROUTES").ok().unwrap_or_else(|| {
+        env::var("REMOTE_API_URL")
+            .map(|url| format!("={url}"))
+            .unwrap_or_else(|_| "=http://localhost:9421/api/auth".to_string())
+    });
+    let mut routes: Vec<Route> = raw
+        .split(',')
+        .filter_map(|entry| {
+            let (prefix, url) = entry.split_once('=')?;
+            let url = url.trim();
+            if url.is_empty() {
+                return None;
+            }
+            Some(Route {
+                prefix_lower: prefix.to_lowercase(),
+                prefix_len: prefix.len(),
+                base_url: url.to_string(),
+            })
+        })
+        .collect();
+    // Longest prefix first so `hall ` (specific) beats `` (default).
+    routes.sort_by(|a, b| b.prefix_len.cmp(&a.prefix_len));
+    routes
 });
 
-// fires when a player sends a message in the minecraft chat
-pub fn on_incoming_chat(uuid: Uuid, msg: String) {
-    tokio::spawn(async move {
