+struct Route {
+    prefix_lower: String,
+    prefix_len: usize,
+    base_url: String,
+}
+
+fn match_route(msg: &str) -> Option<(&'static Route, String)> {
+    let msg_lower = msg.to_lowercase();
+    for route in &*ROUTES {
+        if route.prefix_len == 0 {
+            return Some((route, msg.to_string()));
+        }
+        if msg_lower.starts_with(&route.prefix_lower) {
+            let stripped = msg[route.prefix_len..].trim_start().to_string();
+            return Some((route, stripped));
+        }
+    }
+    None
+}
+
+// fires when a player sends a message in the minecraft chat.
+//
+// Returns `Some(kick_message)` when the matched backend answered with a
+// non-empty `kick_message` field, `None` otherwise. The caller should
+// disconnect the player via `client_state.kick(...)` on `Some`.
+//
+// Runs the HTTP call synchronously so the caller can act on the result.
+// `PacketHandler::handle` is a sync trait method, so we hand off the
+// current worker via `block_in_place` + `Handle::current().block_on(...)`
+// -- safe on tokio default multi-threaded runtime (see `#[tokio::main]`
+// in `main.rs`).
+pub fn on_incoming_chat(uuid: Uuid, msg: String) -> Option<String> {
+    let (route, forwarded) = match_route(&msg)?;
+    let url = build_url(&route.base_url, uuid, &forwarded)?;
+    block_in_place(|| Handle::current().block_on(async move { fetch_kick(&url).await }))
+}
+
+fn build_url(base: &str, uuid: Uuid, msg: &str) -> Option<reqwest::Url> {
+    let mut url = reqwest::Url::parse(base).ok()?;
+    {
+        let mut segments = url.path_segments_mut().ok()?;
+        segments.push(&uuid.to_string());
+        segments.push(msg);
+    }
+    Some(url)
+}
+
+async fn fetch_kick(url: &reqwest::Url) -> Option<String> {
+    let response = reqwest::get(url.clone()).await.ok()?;
+    if !response.status().is_success() {
+        return None;
+    }
+    let body: serde_json::Value = response.json().await.ok()?;
+    body.get("kick_message")
+        .and_then(|v| v.as_str())
+        .filter(|s| !s.is_empty())
+        .map(String::from)
 }
